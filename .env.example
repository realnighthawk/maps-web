VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional Map ID for Advanced Markers (defaults to DEMO_MAP_ID for dev).
# VITE_GOOGLE_MAPS_MAP_ID=

# Production / split-origin (deployed image): public maps-engine URL (scheme + host, no path).
# VITE_MAPS_ENGINE_ORIGIN=https://maps-api.example.com
# Router mode: sign in with Clerk and use YOUR maps-engine instance through the shared router (this is how your recorded
# drives and analytics are read). Needs both. The router must allow this site's origin (ROUTER_ALLOWED_ORIGINS) and
# the live fleet stream is off in this mode. Same publishable key as the phone apps (public by design).
# VITE_ROUTER_ORIGIN=https://harness-router.nighthawklabs.org
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# GitHub project Pages asset path (must match repo Pages URL). Example: /my-repo/
# VITE_BASE_PATH=/

# Dev only: where `yarn dev` proxies `/api/*` (maps-engine). Default http://127.0.0.1:8080
# If something else already listens on 8080 (you may see API errors like "invalid or missing bearer token"),
# run maps-engine on another port (see maps-engine MAPS_ENGINE_HTTP_PORT) and set this to match.
MAPS_ENGINE_PROXY_TARGET=http://127.0.0.1:8181
# Dev only: preview a real tenant instance without signing in. Port-forward its maps-engine, point the proxy target at it,
# and set the Clerk user id the engine expects (its MAPS_ENGINE_OWNER_SUB); the proxy then sends X-Nighthawk-Verified-User.
# MAPS_ENGINE_VERIFIED_USER=user_xxx
